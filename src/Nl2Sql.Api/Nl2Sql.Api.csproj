<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- App Service only has .NET 11 RC1 (we need RC2), so production is published self-contained
       for linux-x64. Declared here so the lock files cover that runtime too. -->
  <PropertyGroup>
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nl2Sql.ServiceDefaults\Nl2Sql.ServiceDefaults.csproj" />
    <ProjectReference Include="..\Nl2Sql.Agent\Nl2Sql.Agent.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Agents.AI.Hosting.AGUI.AspNetCore" />
  </ItemGroup>

</Project>
