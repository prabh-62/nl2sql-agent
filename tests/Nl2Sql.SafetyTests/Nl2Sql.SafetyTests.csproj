    <!-- Needs a real database and Azure sign-in, so `dotnet test` on the solution skips it.
         Run it with: dotnet run (project tests/Nl2Sql.SafetyTests). -->
    <IsTestProject>false</IsTestProject>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Nl2Sql.Data\Nl2Sql.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
